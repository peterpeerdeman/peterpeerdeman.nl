{
  "name": "peterpeerdeman.nl",
  "version": "1.0.0",
  "description": "my personal website",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "npx parcel serve src/index.html",
    "build": "npx parcel build --no-cache src/index.html",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "hooks:install": "git config core.hooksPath .githooks && echo \"git hooks enabled (pre-push deploys master)\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peterpeerdeman/peterpeerdeman.nl"
  },
  "author": "Peter Peerdeman",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/peterpeerdeman/peterpeerdeman.nl/issues"
  },
  "homepage": "https://github.com/peterpeerdeman/peterpeerdeman.nl",
  "devDependencies": {
    "@samkirkland/ftp-deploy": "^1.2.5",
    "parcel": "^2.16.4"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
